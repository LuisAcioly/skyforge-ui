{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "primitive": {
    "color": {
      "base": {
        "white": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "Technical white for raised surfaces and foregrounds."
        },
        "black": {
          "$type": "color",
          "$value": "#000000",
          "$description": "Technical black reserved for alpha overlays and non-UI compositing only. Do not use for visible component states."
        }
      },
      "brand": {
        "carbon-black": {
          "$type": "color",
          "$value": "#161B1E",
          "$description": "Primary brand authority color used for light theme CTAs and dark theme canvas."
        },
        "shadow-ink": {
          "$type": "color",
          "$value": "#323738",
          "$description": "Dark ink surface color separated from neutral 900 for visible dark-mode surfaces."
        },
        "charcoal": {
          "$type": "color",
          "$value": "#515656",
          "$description": "Structural brand neutral aligned with neutral 700."
        },
        "soft-linen": {
          "$type": "color",
          "$value": "#E4E0D5",
          "$description": "Warm editorial surface color used sparingly for narrative emphasis."
        },
        "muted-teal": {
          "$type": "color",
          "$value": "#367656",
          "$description": "Contrast-safe brand accent for links, focus states, and functional emphasis on light surfaces."
        }
      },
      "neutral": {
        "50": {
          "$type": "color",
          "$value": "#F5F6F6",
          "$description": "Primary light canvas."
        },
        "100": {
          "$type": "color",
          "$value": "#E6E7E7",
          "$description": "Subtle light surface and hover tone."
        },
        "200": {
          "$type": "color",
          "$value": "#CFD2D1",
          "$description": "Default light border and divider tone."
        },
        "300": {
          "$type": "color",
          "$value": "#ADB3B3",
          "$description": "Strong light border and muted dark text."
        },
        "400": {
          "$type": "color",
          "$value": "#848C8B",
          "$description": "Muted neutral for non-text affordances and low-emphasis decoration."
        },
        "500": {
          "$type": "color",
          "$value": "#697170",
          "$description": "Secondary content on light backgrounds."
        },
        "600": {
          "$type": "color",
          "$value": "#5A6060",
          "$description": "Secondary icon and strong content tone."
        },
        "700": {
          "$type": "color",
          "$value": "#515656",
          "$description": "Strong neutral and brand charcoal alias."
        },
        "800": {
          "$type": "color",
          "$value": "#404444",
          "$description": "Raised dark surface and active tone with improved contrast against neutral 300 text."
        },
        "900": {
          "$type": "color",
          "$value": "#252627",
          "$description": "Deep neutral for low-emphasis dark surfaces, kept distinct from brand shadow ink."
        }
      },
      "teal": {
        "50": {
          "$type": "color",
          "$value": "#F0F7F3",
          "$description": "Subtle teal background for accents."
        },
        "100": {
          "$type": "color",
          "$value": "#D9EEE3",
          "$description": "Soft teal hover and badge background."
        },
        "200": {
          "$type": "color",
          "$value": "#BFE0CE",
          "$description": "Teal border and tonal surface."
        },
        "300": {
          "$type": "color",
          "$value": "#85B79D",
          "$description": "Light teal accent for dark theme links and non-text accent surfaces."
        },
        "400": {
          "$type": "color",
          "$value": "#66A384",
          "$description": "Medium teal accent for icons and charts."
        },
        "500": {
          "$type": "color",
          "$value": "#4B8F6E",
          "$description": "Mid teal interaction tone."
        },
        "600": {
          "$type": "color",
          "$value": "#367656",
          "$description": "Accessible brand teal for normal text, links, and focus in light theme."
        },
        "700": {
          "$type": "color",
          "$value": "#2B5E47",
          "$description": "Accessible default link and focus tone in light theme."
        },
        "800": {
          "$type": "color",
          "$value": "#214837",
          "$description": "Active teal state in light theme."
        },
        "900": {
          "$type": "color",
          "$value": "#173226",
          "$description": "Strong teal foreground on light teal surfaces."
        }
      },
      "feedback": {
        "success": {
          "50": {
            "$type": "color",
            "$value": "#EAF6EE",
            "$description": "Success background."
          },
          "200": {
            "$type": "color",
            "$value": "#B7DFC4",
            "$description": "Success border."
          },
          "600": {
            "$type": "color",
            "$value": "#2F7D4F",
            "$description": "Success icon."
          },
          "700": {
            "$type": "color",
            "$value": "#1F5A38",
            "$description": "Success text."
          }
        },
        "warning": {
          "50": {
            "$type": "color",
            "$value": "#FFF7D6",
            "$description": "Warning background."
          },
          "200": {
            "$type": "color",
            "$value": "#F6D77A",
            "$description": "Warning border."
          },
          "600": {
            "$type": "color",
            "$value": "#A16207",
            "$description": "Warning icon."
          },
          "700": {
            "$type": "color",
            "$value": "#713F12",
            "$description": "Warning text."
          }
        },
        "error": {
          "50": {
            "$type": "color",
            "$value": "#FFF1F0",
            "$description": "Error background."
          },
          "200": {
            "$type": "color",
            "$value": "#F4B7B4",
            "$description": "Error border."
          },
          "600": {
            "$type": "color",
            "$value": "#C2413D",
            "$description": "Error icon and destructive action."
          },
          "700": {
            "$type": "color",
            "$value": "#8E2421",
            "$description": "Error text."
          }
        },
        "info": {
          "50": {
            "$type": "color",
            "$value": "#EFF6FF",
            "$description": "Info background."
          },
          "200": {
            "$type": "color",
            "$value": "#BFDBFE",
            "$description": "Info border."
          },
          "600": {
            "$type": "color",
            "$value": "#2563A8",
            "$description": "Info icon."
          },
          "700": {
            "$type": "color",
            "$value": "#1E3A70",
            "$description": "Info text."
          }
        }
      }
    },
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "Bebas Neue",
          "$description": "Display font for headings and editorial moments."
        },
        "body": {
          "$type": "fontFamily",
          "$value": "Figtree",
          "$description": "Body font for product UI and long-form readability."
        }
      },
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Caption and metadata size."
        },
        "sm": {
          "$type": "dimension",
          "$value": "14px",
          "$description": "Small body and compact controls."
        },
        "base": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Default body size."
        },
        "lg": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Small heading size."
        },
        "xl": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Medium heading size."
        },
        "2xl": {
          "$type": "dimension",
          "$value": "32px",
          "$description": "Large heading size."
        },
        "3xl": {
          "$type": "dimension",
          "$value": "48px",
          "$description": "Display heading size."
        },
        "4xl": {
          "$type": "dimension",
          "$value": "64px",
          "$description": "Hero display size."
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400,
          "$description": "Default body text weight."
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500,
          "$description": "Metadata and subtle emphasis."
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600,
          "$description": "Labels and control text."
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700,
          "$description": "Headings and strong emphasis."
        }
      },
      "line-height": {
        "tight": {
          "$type": "number",
          "$value": 1.1,
          "$description": "Display and hero line-height."
        },
        "snug": {
          "$type": "number",
          "$value": 1.2,
          "$description": "Heading and label line-height."
        },
        "normal": {
          "$type": "number",
          "$value": 1.5,
          "$description": "Body copy line-height."
        }
      },
      "letter-spacing": {
        "normal": {
          "$type": "dimension",
          "$value": "0em",
          "$description": "Default tracking."
        },
        "eyebrow": {
          "$type": "dimension",
          "$value": "0.08em",
          "$description": "Uppercase editorial eyebrow tracking."
        }
      }
    },
    "spacing": {
      "4": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Micro spacing unit."
      },
      "8": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Default inline gap."
      },
      "12": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Compact component padding."
      },
      "16": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Default component padding."
      },
      "24": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Default card and form spacing."
      },
      "32": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Section and large component spacing."
      },
      "48": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "Page section spacing."
      },
      "64": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Large section spacing."
      },
      "96": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "Editorial layout spacing."
      },
      "128": {
        "$type": "dimension",
        "$value": "128px",
        "$description": "Hero and immersive layout spacing."
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Small radius for badges and compact surfaces."
      },
      "md": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Default control radius."
      },
      "lg": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Card and alert radius."
      },
      "xl": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Editorial card and popover radius."
      },
      "2xl": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Modal and high-emphasis surface radius."
      },
      "full": {
        "$type": "dimension",
        "$value": "9999px",
        "$description": "Fully rounded pills and avatars."
      }
    },
    "border-width": {
      "default": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "Default structural border width."
      },
      "strong": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Focus and selected state border width."
      }
    },
    "shadow": {
      "none": {
        "$type": "shadow",
        "$value": "none",
        "$description": "No elevation."
      },
      "1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgb(22 27 30 / 0.04), 0 8px 24px rgb(22 27 30 / 0.035)",
        "$description": "Subtle elevation for interactive cards and small menus only."
      },
      "2": {
        "$type": "shadow",
        "$value": "0 8px 24px rgb(22 27 30 / 0.08), 0 24px 48px rgb(22 27 30 / 0.06)",
        "$description": "Medium elevation for popovers and floating panels."
      },
      "3": {
        "$type": "shadow",
        "$value": "0 24px 64px rgb(22 27 30 / 0.18), 0 48px 96px rgb(22 27 30 / 0.14)",
        "$description": "High elevation for modals."
      }
    },
    "icon": {
      "library": {
        "$type": "string",
        "$value": "Heroicons",
        "$description": "Official iconography library for the design system."
      },
      "style": {
        "default": {
          "$type": "string",
          "$value": "outline",
          "$description": "Default icon style for navigation, actions, forms, and utility UI."
        },
        "emphasis": {
          "$type": "string",
          "$value": "solid",
          "$description": "Use solid icons only for emphasis, filled badges, and feedback states."
        }
      },
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Dense metadata, small badges, and compact inline affordances."
        },
        "sm": {
          "$type": "dimension",
          "$value": "20px",
          "$description": "Default inline icon size for controls and inputs."
        },
        "md": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Standard navigation, empty-state, and card icon size."
        },
        "lg": {
          "$type": "dimension",
          "$value": "32px",
          "$description": "Large illustrative or feature icon size."
        }
      },
      "stroke-width": {
        "outline": {
          "$type": "number",
          "$value": 1.5,
          "$description": "Consistent Heroicons outline stroke width."
        }
      }
    },
    "layout": {
      "breakpoint": {
        "mobile": {
          "$type": "dimension",
          "$value": "720px",
          "$description": "Single-column mobile layout breakpoint used by the showcase."
        },
        "tablet": {
          "$type": "dimension",
          "$value": "1040px",
          "$description": "Intermediate collapse point for navigation and major grids."
        }
      },
      "container": {
        "shell": {
          "$type": "dimension",
          "$value": "1180px",
          "$description": "Maximum width for the documentation shell container."
        }
      }
    }
  }
}