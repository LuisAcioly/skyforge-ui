          "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"]
        }
      },
      "font-size": {
        "xs": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "code": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "sm": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "base": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "lg": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
