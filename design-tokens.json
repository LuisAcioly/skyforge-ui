{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Skyforge Design System v2 — canonical primitives and semantic roles. Carbon Black neutralized to #18181A and the neutral ramp rebuilt off it (R=G, B +1..+6). Feedback hues and linen promoted to full 10-step scales. Additive: no token was renamed or removed.",
  "primitive": {
    "color": {
      "base": {
        "white": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "Technical white for raised surfaces and foregrounds."
        },
        "black": {
          "$type": "color",
          "$value": "#000000",
          "$description": "Technical black reserved for alpha overlays and non-UI compositing only. Never for visible component states."
        }
      },
      "brand": {
        "carbon-black": {
          "$type": "color",
          "$value": "{primitive.color.neutral.950}",
          "$description": "v2: neutralized from #161B1E. Primary brand authority color — light theme CTAs, dark theme canvas. Anchors the neutral ramp."
        },
        "shadow-ink": {
          "$type": "color",
          "$value": "#323238",
          "$description": "v2: neutralized from #323738. Dark ink surface, separated from neutral 900 for visible dark-mode surfaces."
        },
        "charcoal": {
          "$type": "color",
          "$value": "{primitive.color.neutral.700}",
          "$description": "v2: neutralized from #515656. Structural brand neutral aligned with neutral 700."
        },
        "soft-linen": {
          "$type": "color",
          "$value": "{primitive.color.linen.100}",
          "$description": "Warm editorial surface color used sparingly for narrative emphasis. The only warm family in the system."
        },
        "muted-teal": {
          "$type": "color",
          "$value": "{primitive.color.teal.600}",
          "$description": "Contrast-safe brand accent for links, focus states, and functional emphasis on light surfaces."
