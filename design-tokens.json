{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Skyforge Design System v2 — color tokens. Carbon Black neutralized to #18181A and the neutral ramp rebuilt off it (R=G, B +2..+6). Feedback hues and linen promoted to full 10-step scales. Additive: no token was renamed or removed.",
  "primitive": {
    "color": {
      "base": {
        "white": {
          "$type": "color",
          "$value": "#FFFFFF",
          "$description": "Technical white for raised surfaces and foregrounds."
        },
        "black": {
          "$type": "color",
          "$value": "#000000",
          "$description": "Technical black reserved for alpha overlays and non-UI compositing only. Never for visible component states."
        }
      },
      "brand": {
        "carbon-black": {
          "$type": "color",
          "$value": "#18181A",
          "$description": "v2: neutralized from #161B1E. Primary brand authority color — light theme CTAs, dark theme canvas. Anchors the neutral ramp."
        },
        "shadow-ink": {
          "$type": "color",
          "$value": "#323238",
          "$description": "v2: neutralized from #323738. Dark ink surface, separated from neutral 900 for visible dark-mode surfaces."
        },
